# =============================================================================
# LEO AI Backend – Environment Variable Reference
# Copy this file to .env for local development. NEVER commit .env to git.
# =============================================================================

# --- Application ---
APP_ENV=development          # development | production | testing
APP_SECRET_KEY=changeme-use-a-long-random-string-in-production
APP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
APP_CORS_ORIGINS=["http://localhost:3000"]

# --- Database ---
DATABASE_URL=postgresql+asyncpg://leo_user:leo_password@localhost:5432/leo_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- LLM Provider (choose one provider at a time) ---
LLM_PROVIDER=gemini          # gemini | openai | anthropic | mock
LLM_MODEL=gemini-2.5-flash   # or gpt-4o-mini, claude-3-5-sonnet-20241022
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# Google Gemini (used when LLM_PROVIDER=gemini, EMBEDDINGS_PROVIDER=gemini, or TTS_PROVIDER=gemini)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# OpenAI (used when LLM_PROVIDER=openai or EMBEDDINGS_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# --- Voice: Text-to-Speech (TTS) ---
TTS_PROVIDER=mock            # mock | gemini | elevenlabs
TTS_MODEL=gemini-2.0-flash
TTS_VOICE=Aoede              # Aoede (warm, composed) | Charon | Puck | Fenrir | Kore
TTS_LANGUAGE_CODE=en-IN      # en-IN (Indian English) | hi-IN (Hindi)
TTS_SPEAKING_RATE=1.0

# --- Voice: Speech-to-Text (STT) ---
STT_PROVIDER=mock            # mock | gemini | whisper
STT_MODEL=gemini-2.0-flash
STT_LANGUAGE_HINT=en-IN

# --- Embeddings Provider ---
EMBEDDINGS_PROVIDER=mock     # mock | openai | gemini
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIMENSIONS=1536

# --- Knowledge / RAG ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_RETRIEVAL_RESULTS=5
MIN_SIMILARITY_SCORE=0.70

# --- Security ---
API_KEY_HEADER=X-API-Key
ADMIN_API_KEY=changeme-admin-key
RATE_LIMIT_PER_MINUTE=60

# --- Observability ---
METRICS_ENABLED=true
SENTRY_DSN=                  # optional
